{
  "name": "@ayunaio/scaffold",
  "description": "Nx plugin with generators for go, py and ts projects",
  "version": "0.1.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "tools/scaffold/dist",
          "main": "tools/scaffold/src/index.ts",
          "tsConfig": "tools/scaffold/tsconfig.lib.json",
          "rootDir": "tools/scaffold/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./tools/scaffold/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./tools/scaffold/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      },
      "test": {
        "options": {
          "env": {
            "NODE_OPTIONS": "--experimental-vm-modules"
          }
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "23.2.0",
    "js-toml": "^2.0.1",
    "tslib": "^2.3.0",
    "yaml": "^2.9.0"
  },
  "generators": "./generators.json",
  "executors": "./executors.json",
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json",
    "executors.json"
  ]
}
