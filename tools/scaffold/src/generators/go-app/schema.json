{
  "$schema": "https://json-schema.org/schema",
  "$id": "GoApp",
  "title": "Go Application Generator",
  "type": "object",
  "properties": {
    "repoNamespace": {
      "type": "string",
      "description": "The namespace of the repository.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the repository namespace?"
    },
    "name": {
      "type": "string",
      "description": "The name of the Go application",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "x-prompt": "What is the application name would you like to use?"
    },
    "modulePrefix": {
      "type": "string",
      "description": "The module prefix for the Go application",
      "default": "github.com/org/project",
      "x-prompt": "What is the module prefix for the Go application?"
    }
  },
  "required": ["repoNamespace", "name"]
}
