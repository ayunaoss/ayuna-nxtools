{
  "private": false,
  "type": "module",
  "name": "@<%= repoNamespace %>/<%= name %>",
  "version": "0.1.0",
  "description": "<%= summary %>",
  "exports": {
    "./index.js": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "deepclean": "rimraf dist node_modules .tsbuildinfo",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "jest",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": ["<%= repoNamespace %>", "<%= name %>", "library"],
  "author": {
    "name": "<%= authorName %>",
    "email": "<%= authorEmail %>"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "jest": "^30.4.2",
    "@nx/jest": "23.2.0",
    "rimraf": "^6.1.3",
    "@swc/core": "^1.16.13",
    "@swc/jest": "0.2.39",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
