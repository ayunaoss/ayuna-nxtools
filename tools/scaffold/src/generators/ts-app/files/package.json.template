{
  "private": true,
  "type": "module",
  "name": "@<%= repoNamespace %>/<%= name %>",
  "version": "0.1.0",
  "description": "<%= summary %>",
  "scripts": {
    "clean": "rimraf dist",
    "deepclean": "rimraf dist node_modules .tsbuildinfo",
    "lint": "biome check src",
    "format": "biome format --write src",
    "test": "jest",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "keywords": ["<%= repoNamespace %>", "<%= name %>", "application"],
  "author": {
    "name": "<%= authorName %>",
    "email": "<%= authorEmail %>"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "jest": "^30.4.2",
    "@nx/jest": "23.2.0",
    "rimraf": "^6.1.3",
    "@swc/core": "^1.16.13",
    "@swc/jest": "0.2.39",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
