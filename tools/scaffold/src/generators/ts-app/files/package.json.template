{
  "private": true,
  "type": "module",
  "name": "@<%= repoNamespace %>/<%= name %>",
  "version": "0.1.0",
  "description": "<%= summary %>",
  "scripts": {
    "clean": "rimraf dist",
    "deepclean": "rimraf dist node_modules .tsbuildinfo",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "test": "jest",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "keywords": ["<%= repoNamespace %>", "<%= name %>", "application"],
  "author": {
    "name": "<%= authorName %>",
    "email": "<%= authorEmail %>"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.2",
    "jest": "^30.4.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.75.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {}
}
