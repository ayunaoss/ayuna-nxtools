{
  "$schema": "https://json-schema.org/schema",
  "$id": "TsApp",
  "title": "TypeScript Application Generator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the TypeScript application",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the TypeScript application name would you like to use?"
    },
    "repoNamespace": {
      "type": "string",
      "description": "The namespace of the repository.",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "x-prompt": "What is the repository namespace?"
    },
    "authorName": {
      "type": "string",
      "description": "The name of the author.",
      "$default": {
        "$source": "argv",
        "index": 2
      },
      "x-prompt": "What is the author's name?"
    },
    "authorEmail": {
      "type": "string",
      "description": "The email of the author.",
      "$default": {
        "$source": "argv",
        "index": 3
      },
      "x-prompt": "What is the author's email?"
    },
    "summary": {
      "type": "string",
      "description": "A short summary of the TypeScript application.",
      "default": "My sample TypeScript application",
      "x-prompt": "What is this TypeScript application about?"
    }
  },
  "required": ["name", "repoNamespace", "authorName", "authorEmail"]
}
